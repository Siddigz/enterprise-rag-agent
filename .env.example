# Copy to .env. docker compose reads it for variable substitution; the app reads it for local runs.
ANTHROPIC_API_KEY=

# anthropic | fake  (fake = deterministic offline stub + heuristic judge, no key needed)
LLM_PROVIDER=anthropic
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
JUDGE_MODEL=claude-opus-5-5
JUDGE_EFFORT=high

# Local (non-docker) runs
DATABASE_URL=postgresql+psycopg://recon:recon@localhost:5432/recon
DATA_DIR=data/raw
REPORTS_DIR=reports

# fastembed | hash
EMBEDDING_PROVIDER=fastembed

# Eval
EVAL_SAMPLE_SIZE=
EVAL_CONCURRENCY=4
GROUNDING_THRESHOLD=0.95
ANSWER_ACCURACY_THRESHOLD=0.8
